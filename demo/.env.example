# --- Supabase (optional) ---
# Database: app traffic through the transaction pooler (6543) as the limited forecast_backend role,
# migrations through the session pooler or direct connection (5432) as the postgres owner.
# DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# DATABASE_USERNAME=forecast_backend.<project-ref>
# DATABASE_PASSWORD=
# FLYWAY_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# FLYWAY_USERNAME=postgres.<project-ref>
# FLYWAY_PASSWORD=
# Storage: Project Settings > Storage > S3 connection. Create the private bucket first.
# STORAGE_BACKEND=s3
# STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=<region>
# STORAGE_S3_BUCKET=raw-sources
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
