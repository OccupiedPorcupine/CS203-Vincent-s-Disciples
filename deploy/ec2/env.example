# Settings for Chicky on EC2. Copy to deploy/ec2/.env on the server (never commit .env), fill in
# every value, then `chmod 600 .env`. They match Vercel Production's environment variables; the
# secret values come from Supabase, Google Cloud, Gmail, OpenAI and @BotFather, not from Vercel
# (it doesn't show sensitive values again).

# The site's address, without https://. Its DNS A record must point at the instance's Elastic IP.
CHICKY_DOMAIN=app.example.com

# Supabase Production, with the prod profile's safety checks on (deploy/README.md, "prod profile").
SPRING_PROFILES_ACTIVE=supabase,prod
# Use Supabase's connection pooler address (Project Settings → Database → Connection string →
# Session pooler), as Vercel does: the direct address is IPv6 only, and EC2 is IPv4 by default.
DATABASE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=

# Must be https:// and the same address as CHICKY_DOMAIN, or the prod profile refuses to start.
APP_BASE_URL=https://app.example.com
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

# Google sign-in. Add https://CHICKY_DOMAIN to the client's "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=704664738768-t2iot0sqoe810ks8m65fr8rkvu6071gh.apps.googleusercontent.com

# Password reset and verification emails (Gmail with an app password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=chicky.sg.csdproj@gmail.com
MAIL_PASSWORD=
MAIL_FROM=Chicky <chicky.sg.csdproj@gmail.com>

# The assistant.
OPENAI_API_KEY=

# The hourly chat reminders job (.github/workflows/chat-reminders.yml sends the same value).
CRON_SECRET=

# Telegram. A bot has one webhook, so only the site that registered it last gets messages
# (README.md, "Switching over").
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
