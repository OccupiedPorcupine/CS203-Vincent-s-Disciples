# Copy this file to backend/.env and fill it in. backend/.env is gitignored: never commit it.
# Format: KEY=value, with no spaces around "=" and no quotes.

# Google OAuth client ID (optional). Leave it empty to turn Google sign-in off: the login page hides
# the Google button and email/password login still works. Never put a placeholder here: a made-up
# value shows a Google button that fails with "Error 401: invalid_client" (issue #16).
# To use Google sign-in, ask the team for the shared client ID (it is shared privately, never committed).
GOOGLE_CLIENT_ID=

# --- Supabase (optional) ---
# Leave these commented out to use the local in-memory H2 database.
# To use Supabase, uncomment all four lines. See database/README.md for where to find each value.
# Write the first line exactly like this: SPRING_PROFILES_ACTIVE=supabase does NOT work in this file.
# spring.profiles.active=supabase
# DATABASE_URL=jdbc:postgresql://<pooler host>:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<project ref>
# DATABASE_PASSWORD=<database password>

# --- Voice assistant ---
# OpenAI API key for the assistant (speech-to-text and the language model). Without it, the
# assistant reports that it is unavailable; set ASSISTANT_PROVIDER=offline to try typed sales
# entry without a key.
# OPENAI_API_KEY=sk-...
# ASSISTANT_PROVIDER=offline
